# Admin (apps/admin)
# Copy to .env.local

# Cognito auth (Hosted UI + OAuth code flow). In prod these are injected by the
# AdminStack from the AuthStack outputs; set them locally to test sign-in.
COGNITO_REGION=eu-west-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
# Public app origin behind CloudFront (OAuth redirect/logout URIs). Leave unset
# locally to use the request origin (http://localhost:3001).
APP_ORIGIN=
# REQUIRED. Admin allowlist (CSV of emails) — no fallback, sign-in throws if unset.
# In prod injected by the AdminStack from the `adminAllowedEmails` context
# (GitHub variable). Set it here for local sign-in.
ADMIN_ALLOWED_EMAILS=test@example.com,test2@example.com

# Public portfolio URL (local: http://localhost:3000)
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Same value as apps/web REVALIDATE_SECRET
REVALIDATE_SECRET=

# Media uploads — S3 (MediaStore port). Uploads are disabled until both are set.
# Locally, point S3_ENDPOINT at MinIO/LocalStack; in prod the Lambda role supplies creds.
S3_MEDIA_BUCKET=
MEDIA_PUBLIC_BASE_URL=
# AWS region (primary region; defaults to eu-west-1 when unset)
AWS_REGION=eu-west-1
# Optional local-dev override for the S3 client (MinIO/LocalStack)
S3_ENDPOINT=

# Resume AI — Anthropic (primary model, Claude Sonnet 4.5)
ANTHROPIC_API_KEY=

# Resume AI — Groq (fast draft, silent fallback, ATS scoring)
GROQ_API_KEY=

# Resume AI — per-user rate limiting via the RateLimiter port (DynamoDB when
# DATA_BACKEND=dynamo, otherwise a no-op that always allows in local dev).

# Resume AI — daily cost cap (USD) per admin user. Defaults to 5.
RESUME_GEN_DAILY_USD_CAP=5

# --- Data layer (@portfolio/data) ---
# Backend selector: "fixture" (default, local) or "dynamo".
DATA_BACKEND=fixture
# DynamoDB table-name prefix (prod). Tables are <prefix>-content, <prefix>-experience,
# etc. Defaults to "portfolio".
DYNAMO_TABLE_PREFIX=portfolio
# For local DynamoDB (docker compose); leave unset in prod (uses Lambda role).
DYNAMODB_LOCAL_ENDPOINT=
