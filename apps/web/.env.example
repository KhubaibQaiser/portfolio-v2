# Portfolio (apps/web)
# Copy to .env.local

# Canonical site URL (local: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=https://khubaibqaiser.com

# Groq (AI chat)
# Groq — Secrets Manager complete ARN (required for chat; copy from SSM /portfolio/ai/groq-api-key-arn)
GROQ_API_KEY_SECRET_ARN=

# GitHub API (optional; improves rate limits for stats)
GITHUB_TOKEN=

# PostHog — analytics, error tracking, session replay (project API key; safe to expose)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# Ingestion API (US: https://us.i.posthog.com | EU: https://eu.i.posthog.com)
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# App URL for toolbar / UI links (US: https://us.posthog.com | EU: https://eu.posthog.com)
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
# Optional: e.g. production, preview, development (registered as a super-property)
NEXT_PUBLIC_POSTHOG_ENVIRONMENT=

# PostHog — server-side / build (optional)
# Same as NEXT_PUBLIC_POSTHOG_ENVIRONMENT or override for API routes
POSTHOG_ENVIRONMENT=
# Personal API key + project ID — required for production source map upload to PostHog (error tracking stack traces)
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
# PostHog app host for the Next.js config wrapper (defaults in next.config.ts)
POSTHOG_APP_HOST=https://us.posthog.com

# Chat rate limiting via the RateLimiter port (DynamoDB when DATA_BACKEND=dynamo,
# otherwise a no-op that always allows). Max chat POSTs per IP per window.
CHAT_RATE_LIMIT_MAX=10
CHAT_RATE_LIMIT_WINDOW_SEC=60

# Contact form (Resend + Cloudflare Turnstile)
#
# Local dev: set RESEND_API_KEY, TURNSTILE_SECRET_KEY, NEXT_PUBLIC_TURNSTILE_SITE_KEY,
# CONTACT_TO_EMAIL, and CONTACT_FROM_EMAIL directly (leave *_SECRET_ARN empty).
#
# Production: Lambda reads RESEND_API_KEY_SECRET_ARN and TURNSTILE_SECRET_KEY_SECRET_ARN
# from Secrets Manager; CONTACT_TO_EMAIL / CONTACT_FROM_EMAIL come from CDK context.
#
# Resend: create key at https://resend.com/api-keys (Sending access).
# Until your domain is verified, use CONTACT_FROM_EMAIL=onboarding@resend.dev and
# CONTACT_TO_EMAIL must be the email on your Resend account.
#
# Turnstile: create an Invisible widget at https://dash.cloudflare.com/?to=/:account/turnstile
# Local testing keys (always pass, invisible):
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000BB
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Docs: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
RESEND_API_KEY=
RESEND_API_KEY_SECRET_ARN=
TURNSTILE_SECRET_KEY=
TURNSTILE_SECRET_KEY_SECRET_ARN=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Data layer (@portfolio/data) ---
# Backend selector: "fixture" (default, local) or "dynamo".
DATA_BACKEND=fixture
# DynamoDB table-name prefix (prod). Tables are <prefix>-content, <prefix>-experience,
# etc. Defaults to "portfolio".
DYNAMO_TABLE_PREFIX=portfolio
# For local DynamoDB (docker compose); leave unset in prod (uses Lambda role).
DYNAMODB_LOCAL_ENDPOINT=
# AWS region (primary region; defaults to eu-west-1 when unset).
AWS_REGION=eu-west-1
# Media (read-only on web): public base URL objects are served from (S3/CloudFront).
MEDIA_PUBLIC_BASE_URL=
# Optional local S3-compatible endpoint (MinIO/LocalStack).
S3_ENDPOINT=
S3_MEDIA_BUCKET=
