{
  "name": "portfolio-v2",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@portfolio/web",
    "dev:admin": "turbo run dev --filter=@portfolio/admin",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "DYNAMODB_LOCAL_ENDPOINT=http://localhost:8000 vitest run",
    "test:e2e": "playwright test --config apps/web/playwright.config.ts",
    "ddb:up": "docker compose -f docker-compose.dev.yml up -d",
    "ddb:down": "docker compose -f docker-compose.dev.yml down",
    "format": "prettier --write \"**/*.{ts,tsx,md,mdx,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,mdx,json,css}\"",
    "storybook": "pnpm --filter @portfolio/ui storybook",
    "build-storybook": "pnpm --filter @portfolio/ui build-storybook",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:types": "supabase gen types typescript --linked > packages/shared/src/supabase/database.types.ts",
    "db:reset": "supabase db reset"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.2",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.9.6",
    "vitest": "^4.1.9"
  }
}
