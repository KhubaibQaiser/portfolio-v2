{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "NODE_ENV",
        "NEXT_PUBLIC_*",
        "MEDIA_PUBLIC_BASE_URL",
        "PORTFOLIO_OPENNEXT_BUILD",
        "APP_ORIGIN",
        "DATA_BACKEND",
        "DYNAMO_TABLE_PREFIX",
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY",
        "AWS_SESSION_TOKEN",
        "AWS_REGION",
        "AWS_DEFAULT_REGION",
        "POSTHOG_API_KEY",
        "POSTHOG_PROJECT_ID",
        "POSTHOG_APP_HOST",
        "POSTHOG_ENVIRONMENT",
        "SKIP_ENV_VALIDATION"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "storybook-static/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
