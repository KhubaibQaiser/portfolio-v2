{
  "name": "@portfolio/data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tables": "./src/dynamo/tables.ts",
    "./media": "./src/media.ts",
    "./fixtures": "./src/fixtures/content.ts",
    "./adapters/fixture": "./src/adapters/fixture-content-repository.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "seed:generate": "python3 scripts/generate-seed-from-export.py",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1075.0",
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/client-sqs": "^3.1075.0",
    "@aws-sdk/lib-dynamodb": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@portfolio/shared": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.2"
  }
}
